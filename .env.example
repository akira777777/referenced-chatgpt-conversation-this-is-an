# ==============================================================================
# RE:Art — Electronics Repair Service — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Site URL (your Vercel domain)
NEXT_PUBLIC_SITE_URL=https://reart.cz

# Supabase Database & Auth (https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Telegram Notifications (@liltrafficRUS)
# 1. Create a bot with @BotFather to get the token
# 2. Get your Chat ID with @userinfobot or add bot to channel
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=123456789

# Admin panel password (protects /admin route)
ADMIN_SECRET=your-super-secret-admin-password
